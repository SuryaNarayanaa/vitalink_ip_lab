{
  "name": "backend",
  "version": "1.0.0",
  "description": "A backend for the vitalink app in express and typescript",
  "main": "build/src/server.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node --require tsconfig-paths/register\" src/server.ts",
    "build": "tsc && tsc-alias",
    "vercel-build": "tsc && tsc-alias",
    "start": "node build/src/server.js",
    "test": "jest",
    "lint:openapi": "redocly lint docs/api/openapi.yaml",
    "ci": "npm run build && npm test",
    "load:inventory": "tsx load-tests/inventory/generate-inventory.ts",
    "load:inventory:verify": "tsx load-tests/inventory/verify-inventory.ts",
    "load:typecheck": "tsc -p load-tests/tsconfig.json",
    "load:coverage": "node load-tests/scenarios/verify-coverage.mjs",
    "load:report:test": "tsx --test load-tests/reporting/merge-results.test.ts",
    "load:capacity": "node load-tests/capacity/controller.mjs",
    "load:capacity:test": "node --test load-tests/capacity/capacity.test.mjs",
    "load:mutations:test": "tsx --test load-tests/mutations/ledger.test.ts",
    "load:verify": "npm run load:inventory && npm run load:inventory:verify && npm run load:typecheck && npm run load:coverage && npm run load:report:test && npm run load:capacity:test && npm run load:mutations:test",
    "load:fixtures:dry-run": "tsx load-tests/fixtures/seed.ts --dry-run",
    "load:fixtures:seed": "tsx load-tests/fixtures/seed.ts",
    "load:fixtures:verify": "tsx load-tests/fixtures/verify.ts",
    "load:fixtures:context": "tsx load-tests/fixtures/build-context.ts",
    "load:fixtures:finalize": "tsx load-tests/fixtures/finalize.ts",
    "load:report": "tsx load-tests/reporting/merge-results.ts",
    "load:suite": "node load-tests/run-suite.mjs",
    "seed": "ts-node --require tsconfig-paths/register src/scripts/createAdminUser.ts",
    "seed:prod": "node build/src/scripts/createAdminUser.js",
    "bootstrap:admin": "ts-node --require tsconfig-paths/register src/scripts/createAdminUser.ts",
    "bootstrap:admin:prod": "node build/src/scripts/createAdminUser.js",
    "migrate:assigned-doctor-ids": "ts-node --require tsconfig-paths/register src/scripts/migrateAssignedDoctorIds.ts",
    "migrate:assigned-doctor-ids:prod": "node build/src/scripts/migrateAssignedDoctorIds.js",
    "migrate:patient-hospital-ids": "ts-node --require tsconfig-paths/register src/scripts/backfillPatientHospitalIds.ts",
    "migrate:patient-hospital-ids:prod": "node build/src/scripts/backfillPatientHospitalIds.js",
    "migrate:inr-critical-flags": "ts-node --require tsconfig-paths/register src/scripts/migrateInrCriticalFlags.ts",
    "migrate:inr-critical-flags:prod": "node build/src/scripts/migrateInrCriticalFlags.js",
    "migrate:auth-schema-defaults": "ts-node --require tsconfig-paths/register src/scripts/migrateAuthSchemaDefaults.ts",
    "migrate:auth-schema-defaults:prod": "node build/src/scripts/migrateAuthSchemaDefaults.js",
    "migrate:doctor-update-notifications": "ts-node --require tsconfig-paths/register src/scripts/migrateDoctorChangeEventsToNotifications.ts",
    "migrate:doctor-update-notifications:prod": "node build/src/scripts/migrateDoctorChangeEventsToNotifications.js",
    "migrate:file-assets": "ts-node --require tsconfig-paths/register src/scripts/backfillFileAssets.ts",
    "migrate:file-assets:prod": "node build/src/scripts/backfillFileAssets.js",
    "migrate:device-tokens": "ts-node --require tsconfig-paths/register src/scripts/migrateDeviceTokenOwnership.ts",
    "migrate:device-tokens:prod": "node build/src/scripts/migrateDeviceTokenOwnership.js",
    "purge:patient-files": "ts-node --require tsconfig-paths/register src/scripts/purgePatientFiles.ts",
    "purge:patient-files:prod": "node build/src/scripts/purgePatientFiles.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^14.1.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "mongoose": "9.1.6",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "nodemon": "^3.1.11",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.3",
    "yaml": "^2.9.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@redocly/cli": "^2.38.0",
    "@types/axios": "^0.14.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/helmet": "^4.0.0",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "29.7.0",
    "jest-util": "29.7.0",
    "testcontainers": "^11.11.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "^2.0.2",
    "body-parser": "^2.2.1",
    "uuid": "^11.1.1"
  }
}
